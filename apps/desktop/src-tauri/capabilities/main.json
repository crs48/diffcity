{
  "identifier": "main",
  "description": "The bundled diffcity main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-bootstrap",
    "allow-refresh-inbox",
    "allow-list-pull-history",
    "allow-refresh-directory",
    "allow-save-settings",
    "allow-open-pull",
    "allow-open-saved-review",
    "core:window:allow-destroy",
    "allow-check-pull",
    "allow-save-note",
    "allow-delete-note",
    "allow-save-progress",
    "allow-analyze",
    "allow-ask-codex",
    "allow-cancel-codex",
    "allow-publish-review",
    "allow-sample-review",
    "allow-sample-inbox",
    "allow-open-external"
  ]
}
