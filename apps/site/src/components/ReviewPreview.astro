---
import Icon from "./Icon.astro";
const screenshots = [
  {
    id: "guide",
    label: "Follow the code",
    icon: "branch",
    image: "guided-review",
    title: "The explanation follows the code.",
    description:
      "The schema backfill sample, with Claude’s risk summary beside the actual SQL diff.",
    alt: "Diff City guided review of a schema backfill, with Claude’s explanation and attention level beside the SQL migration.",
    pr: 9,
  },
  {
    id: "overview",
    label: "Start with the overview",
    icon: "file",
    image: "overview",
    title: "Understand the change before reading the diff.",
    description:
      "A real Claude Code overview of the invitation sample PR, connecting the intended behavior to what the code actually does.",
    alt: "Diff City showing a Claude Fable 5.1 overview of its invitation sample pull request, explaining the changes and review priorities.",
    pr: 1,
  },
  {
    id: "conversation",
    label: "Ask in place",
    icon: "chat",
    image: "inline-conversation",
    title: "A question becomes an inline conversation.",
    description:
      "An actual AI reply about the selected migration lines. The conversation is private; preparing and publishing a GitHub draft are separate actions.",
    alt: "An inline AI conversation in Diff City about the safety of a SQL migration, showing the line reference, the question, and Claude’s response.",
    pr: 9,
  },
];
---

<div
  class="preview-tabs"
  role="tablist"
  aria-label="Explore the review workflow"
>
  {screenshots.map((shot, i) => (
    <button
      type="button"
      role="tab"
      id={`tab-${shot.id}`}
      aria-controls={`panel-${shot.id}`}
      aria-selected={i === 0 ? "true" : "false"}
      tabindex={i === 0 ? 0 : -1}
    >
      <Icon name={shot.icon} size={16} />
      {shot.label}
    </button>
  ))}
</div>
<div class="screenshot-gallery">
  {screenshots.map((shot, i) => (
    <div
      role="tabpanel"
      id={`panel-${shot.id}`}
      aria-labelledby={`tab-${shot.id}`}
      tabindex="0"
      hidden={i !== 0}
    >
      <figure class="app-preview">
        <a
          class="screenshot-link"
          href={`/screenshots/${shot.image}.webp`}
          target="_blank"
          rel="noopener"
          aria-label={`Open full-size screenshot: ${shot.label}`}
        >
          <img
            src={`/screenshots/${shot.image}-1440.webp`}
            srcset={`/screenshots/${shot.image}-960.webp 960w, /screenshots/${shot.image}-1440.webp 1440w, /screenshots/${shot.image}.webp 2752w`}
            sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1244px) calc(100vw - 64px), 1180px"
            width="2752"
            height="1266"
            alt={shot.alt}
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
          />
          <span class="screenshot-expand">
            <Icon name="plus" size={14} /> View full size
          </span>
        </a>
        <figcaption>
          <div>
            <strong>{shot.title}</strong>
            <p>{shot.description}</p>
          </div>
          <a href={`https://github.com/crs48/diffcity/pull/${shot.pr}`}>
            Sample PR #{shot.pr}
            <Icon name="arrow" size={14} />
          </a>
        </figcaption>
      </figure>
    </div>
  ))}
</div>
<p class="capture-note">
  Captured from the real macOS app using sample PRs in the Diff City repo.
  Guides generated with Claude Code · Fable 5.1. Source repo currently private.
</p>
<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
  );
  const activate = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((item) => {
      const active = item === tab;
      item.setAttribute("aria-selected", String(active));
      item.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(
        item.getAttribute("aria-controls")!,
      );
      if (panel) panel.hidden = !active;
    });
    if (focus) tab.focus();
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => activate(tab));
    tab.addEventListener("keydown", (event) => {
      const keys: Record<string, number> = {
        ArrowRight: (index + 1) % tabs.length,
        ArrowLeft: (index + tabs.length - 1) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };
      const next = keys[event.key];
      if (next === undefined) return;
      event.preventDefault();
      activate(tabs[next], true);
    });
  });
</script>
