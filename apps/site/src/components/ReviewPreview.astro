---
import Icon from "./Icon.astro";
const screenshots = [
  {
    id: "guide",
    label: "Follow the code",
    icon: "branch",
    image: "guide-code-notes",
    title: "Important code, with the explanation beside it.",
    description:
      "Claude’s deeper code notes connect to the actual diff. The narrow index keeps chapters, conversations, and reviewed sections within reach.",
    alt: "The full Diff City app showing a Claude Fable 5 guide to its mixed-edit sample PR, code notes beside the diff, and green reviewed sections in the guide rail.",
  },
  {
    id: "overview",
    label: "See the overview",
    icon: "file",
    image: "guide-overview",
    title: "Get the story before the line-by-line review.",
    description:
      "A real Claude Fable 5 walkthrough of a 20-file sample PR: database migrations, access policies, API changes, localization, and more.",
    alt: "The full Diff City app displaying a Mermaid overview, reading path, and personal-account inbox for sample PR 3 with Claude Fable 5.",
  },
  {
    id: "conversation",
    label: "Ask in place",
    icon: "chat",
    image: "inline-review",
    recording: "inline-conversation",
    title: "Keep your question attached to the code.",
    description:
      "Select lines, open the + composer, and ask Claude what to check before shipping a delete endpoint. Scroll through its real answer, then continue the same conversation in PR chat. AI questions stay private; author feedback starts as an unpublished draft.",
    alt: "The full Diff City app showing an inline code conversation with a human question, Claude’s response, and local review controls.",
  },
  {
    id: "chat",
    label: "Keep the context",
    icon: "spark",
    image: "pr-chat",
    title: "Continue the discussion alongside your review.",
    description:
      "The same conversation is available in PR chat, with its code context beside the composer. Copy a response or the whole thread with its context whenever you need it.",
    alt: "The full Diff City app with the independent PR chat open next to the guided diff, showing a contextual AI conversation and copy controls.",
  },
];
---

<div
  class="preview-tabs"
  role="tablist"
  aria-label="Explore the review workflow"
>
  {screenshots.map((shot, i) => (
    <button
      type="button"
      role="tab"
      id={`tab-${shot.id}`}
      aria-controls={`panel-${shot.id}`}
      aria-selected={i === 0 ? "true" : "false"}
      tabindex={i === 0 ? 0 : -1}
    >
      <Icon name={shot.icon} size={16} />
      {shot.label}
    </button>
  ))}
</div>
<div class="screenshot-gallery">
  {screenshots.map((shot, i) => (
    <div
      role="tabpanel"
      id={`panel-${shot.id}`}
      aria-labelledby={`tab-${shot.id}`}
      tabindex="0"
      hidden={i !== 0}
    >
      <figure class="app-preview">
        {shot.recording ? (
          <video
            class="review-recording"
            controls
            playsinline
            preload="none"
            poster={`/demos/${shot.recording}.webp`}
            width="1440"
            height="940"
            aria-label={`${shot.label}: full-window Diff City demonstration, no audio`}
            aria-describedby={`description-${shot.id}`}
          >
            <source src={`/demos/${shot.recording}.mp4`} type="video/mp4" />
            <a href={`/demos/${shot.recording}.gif`}>
              Watch the GIF demonstration
            </a>
          </video>
        ) : (
          <a
            class="screenshot-link"
            href={`/screenshots/${shot.image}.webp`}
            target="_blank"
            rel="noopener"
            aria-label={`View full size: ${shot.label}`}
          >
            <img
              src={`/screenshots/${shot.image}-1440.webp`}
              srcset={`/screenshots/${shot.image}-960.webp 960w, /screenshots/${shot.image}-1440.webp 1440w, /screenshots/${shot.image}.webp 2880w`}
              sizes="(max-width: 700px) calc(100vw - 36px), (max-width: 1244px) calc(100vw - 64px), 1180px"
              width="2880"
              height="1880"
              alt={shot.alt}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
            />
            <span class="screenshot-expand">
              <Icon name="plus" size={14} /> View full size
            </span>
          </a>
        )}
        <figcaption>
          <div id={`description-${shot.id}`}>
            <strong>{shot.title}</strong>
            <p>{shot.description}</p>
            {shot.recording && (
              <p class="recording-links">
                <span>Full app recording · no audio</span>
                <a href={`/demos/${shot.recording}.gif`}>View GIF</a>
                <a href={`/demos/${shot.recording}.mp4`} download>
                  Download video
                </a>
              </p>
            )}
          </div>
          <a href="https://github.com/crs48/diffcity/pull/18">
            Explore the sample
            <Icon name="arrow" size={14} />
          </a>
        </figcaption>
      </figure>
    </div>
  ))}
</div>
<p class="capture-note">
  Full-window recordings and screenshots from the real macOS app using sample
  PRs in the Diff City repo. Guide and replies generated with Claude Code ·
  Fable 5. Recordings are condensed; AI waiting time is shortened. Other account
  avatars are hidden for privacy. Sample code is intentionally flawed and
  available in the source repo for trying the review workflow yourself.
</p>
<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
  );
  const activate = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((item) => {
      const active = item === tab;
      item.setAttribute("aria-selected", String(active));
      item.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(
        item.getAttribute("aria-controls")!,
      );
      if (panel) {
        panel.hidden = !active;
        if (!active)
          panel.querySelectorAll("video").forEach((video) => video.pause());
      }
    });
    if (focus) tab.focus();
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => activate(tab));
    tab.addEventListener("keydown", (event) => {
      const keys: Record<string, number> = {
        ArrowRight: (index + 1) % tabs.length,
        ArrowLeft: (index + tabs.length - 1) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };
      const next = keys[event.key];
      if (next === undefined) return;
      event.preventDefault();
      activate(tabs[next], true);
    });
  });
</script>
