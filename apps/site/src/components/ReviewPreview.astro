---
import Icon from "./Icon.astro";
const lines = [
  {
    n: "18",
    type: "context",
    text: "export async function acceptInvite(token) {",
  },
  {
    n: "19",
    type: "remove",
    text: "  const invite = await findInvite(token);",
  },
  {
    n: "19",
    type: "add",
    text: "  const invite = await findInvite(token, tenant.id);",
  },
  {
    n: "20",
    type: "add",
    text: "  if (!invite || invite.expiresAt <= now()) {",
  },
  { n: "21", type: "add", text: "    throw new InvitationExpiredError();" },
  { n: "22", type: "add", text: "  }" },
  { n: "23", type: "context", text: "  return addMember(invite);" },
  { n: "24", type: "context", text: "}" },
];
const modes = [
  { id: "guide", label: "Follow the story", icon: "branch" },
  { id: "conversation", label: "Ask in place", icon: "chat" },
  { id: "return", label: "Pick up where you left off", icon: "clock" },
];
---

<div
  class="preview-tabs"
  role="tablist"
  aria-label="Explore the review workflow"
>
  {modes.map((mode, i) => (
    <button
      type="button"
      role="tab"
      id={`tab-${mode.id}`}
      aria-controls={`panel-${mode.id}`}
      aria-selected={i === 0 ? "true" : "false"}
      tabindex={i === 0 ? 0 : -1}
    >
      <Icon name={mode.icon} size={16} />
      {mode.label}
    </button>
  ))}
</div>
<figure class="app-preview">
  <div class="window-bar" aria-hidden="true">
    <span class="window-dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span>diffcity / invitations</span>
    <span class="window-shortcut">⌘ K</span>
  </div>
  <div class="app-shell">
    <div class="preview-rail" aria-hidden="true">
      <span class="rail-city">▥</span>
      <span class="rail-selected">
        <Icon name="github" />
      </span>
      <span class="rail-avatar">D</span>
      <span class="rail-bottom">
        <Icon name="spark" />
      </span>
    </div>
    <div class="preview-inbox" aria-hidden="true">
      <div class="inbox-label">
        Pull requests <span>6</span>
      </div>
      <div class="inbox-group">YOUR PULL REQUESTS</div>
      <div class="preview-pr">
        <Icon name="branch" size={16} />
        <div>
          <strong>Clean up the settings page</strong>
          <small>#128 · Draft</small>
        </div>
      </div>
      <div class="inbox-group">YOUR REVIEWS</div>
      <div class="preview-pr active">
        <Icon name="branch" size={16} />
        <div>
          <strong>Make invitations expire safely</strong>
          <small>#126 · Review requested</small>
        </div>
      </div>
      <div class="preview-pr">
        <Icon name="branch" size={16} />
        <div>
          <strong>Streamline the onboarding flow</strong>
          <small>#124 · Updated 2h ago</small>
        </div>
      </div>
      <div class="inbox-group">READY FOR REVIEW</div>
      <div class="preview-pr">
        <Icon name="branch" size={16} />
        <div>
          <strong>Add a French translation</strong>
          <small>#122 · Open</small>
        </div>
      </div>
      <div class="inbox-footer">
        <span class="status-dot"></span> In sync with GitHub
      </div>
    </div>
    <div class="preview-review">
      <div class="preview-heading">
        <div>
          <span class="preview-breadcrumb">
            diffcity / invitations <span>#126</span>
          </span>
          <h3>Make invitations expire safely</h3>
        </div>
        <span class="diff-count">
          <span>+84</span> <span>−12</span>
        </span>
      </div>
      <div class="review-topline">
        <span class="guide-label">
          <Icon name="spark" size={14} /> Guided review
        </span>
        <span class="preview-muted">Codex or Claude · your choice</span>
      </div>
      <div
        id="panel-guide"
        role="tabpanel"
        aria-labelledby="tab-guide"
        tabindex="0"
      >
        <div class="preview-progress">
          <span>01 / 04</span> Start with the access boundary{" "}
          <span class="progress-track">
            <i></i>
          </span>
        </div>
        <div class="preview-code-layout">
          <div class="preview-annotation">
            <span class="attention-label">PAY ATTENTION</span>
            <h4>
              Keep invitations <br />
              inside their team.
            </h4>
            <p>
              The lookup now checks the tenant before accepting an invitation.
            </p>
            <div class="annotation-note">
              <span class="annotation-number">1</span>
              <p>
                <strong>Check the boundary.</strong> <br />
                An expired invitation should never create a membership.
              </p>
            </div>
            <span class="annotation-line" aria-hidden="true"></span>
          </div>
          <div class="preview-code">
            <div class="preview-file">
              <Icon name="file" size={15} />
              <span>src/auth/invitations.ts</span>
              <span class="file-plus">+4 −1</span>
            </div>
            <div class="code-gap">⋯ 17 unchanged lines</div>
            <div class="code-lines">
              {lines.map((line) => (
                <div class:list={["code-line", line.type]}>
                  <span class="code-number">{line.n}</span>
                  <span class="code-sign">
                    {line.type === "add"
                      ? "+"
                      : line.type === "remove"
                        ? "−"
                        : " "}
                  </span>
                  <code>{line.text}</code>
                </div>
              ))}
            </div>
            <div class="folded-file">
              <Icon name="chevron" size={14} />
              <span>2 translation files</span>
              <span>Routine · folded</span>
            </div>
          </div>
        </div>
      </div>
      <div
        id="panel-conversation"
        role="tabpanel"
        aria-labelledby="tab-conversation"
        tabindex="0"
        hidden
      >
        <div class="preview-progress">
          <span>
            <Icon name="chat" size={14} />
          </span>{" "}
          A conversation, right where the question starts
        </div>
        <div class="conversation-demo">
          <div class="preview-file">
            <Icon name="file" size={15} /> src/auth/invitations.ts{" "}
            <span class="file-plus">+4 −1</span>
          </div>
          <div class="code-line selected">
            <span class="sample-plus" aria-hidden="true">
              +
            </span>
            <span class="code-number">20</span>
            <code>if (!invite || invite.expiresAt &lt;= now()) &#123;</code>
          </div>
          <div class="sample-thread">
            <div class="thread-heading">
              <Icon name="spark" size={14} />
              <strong>The expiry boundary</strong>
              <span>Private AI conversation</span>
            </div>
            <div class="sample-message">
              <span class="sample-person">You</span>
              <p>
                Why does this use <code>&lt;=</code> instead of{" "}
                <code>&lt;</code>?
              </p>
            </div>
            <div class="sample-message">
              <span class="sample-person">
                <Icon name="spark" size={12} /> AI
              </span>
              <p>
                An invitation that expires <strong>exactly now</strong> is
                already expired. Using <code>&lt;=</code> keeps that boundary
                explicit.
              </p>
              <p class="sample-validation">
                Worth checking: add a test at the exact expiry timestamp.
              </p>
            </div>
            <div class="sample-reply">
              <span>↳ Replying to src/auth/invitations.ts · New line 20</span>
              <p>Draft a comment asking for that test…</p>
              <small>Private until you choose to publish to GitHub.</small>
            </div>
          </div>
        </div>
      </div>
      <div
        id="panel-return"
        role="tabpanel"
        aria-labelledby="tab-return"
        tabindex="0"
        hidden
      >
        <div class="preview-progress">
          <span>
            <Icon name="clock" size={14} />
          </span>{" "}
          Another push. A focused second look.
        </div>
        <div class="return-demo">
          <div class="comparison">
            <span>Full PR</span>
            <strong>
              Since your last review <span>+12 −2</span>
            </strong>
          </div>
          <div class="return-summary">
            <span class="status-check">
              <Icon name="check" size={18} />
            </span>
            <div>
              <h4>Your previous review is the starting point.</h4>
              <p>Focus on what changed after your last checkpoint.</p>
            </div>
          </div>
          <div class="preview-file">
            <Icon name="file" size={15} /> tests/invitations.test.ts{" "}
            <span class="file-plus">+12 −2</span>
          </div>
          <div class="code-gap">⋯ Previously reviewed code</div>
          <div class="code-line add">
            <span class="code-number">42</span>
            <span class="code-sign">+</span>
            <code>
              it('rejects an invitation at its expiry time', () =&gt; &#123;
            </code>
          </div>
          <div class="code-line add">
            <span class="code-number">43</span>
            <span class="code-sign">+</span>
            <code> expect(acceptInvite(expiredToken)).rejects.toThrow();</code>
          </div>
          <div class="code-line add">
            <span class="code-number">44</span>
            <span class="code-sign">+</span>
            <code>&#125;);</code>
          </div>
          <div class="return-footnote">
            Same PR. Less rereading. A clearer next step.
          </div>
        </div>
      </div>
    </div>
  </div>
  <figcaption>
    Illustrative review with sample data. Your code stays in your workspace
    until you send it to your chosen AI provider.
  </figcaption>
</figure>
<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
  );
  const activate = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((item) => {
      const active = item === tab;
      item.setAttribute("aria-selected", String(active));
      item.tabIndex = active ? 0 : -1;
      const panel = document.getElementById(
        item.getAttribute("aria-controls")!,
      );
      if (panel) panel.hidden = !active;
    });
    if (focus) tab.focus();
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => activate(tab));
    tab.addEventListener("keydown", (event) => {
      const keys: Record<string, number> = {
        ArrowRight: (index + 1) % tabs.length,
        ArrowLeft: (index + tabs.length - 1) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };
      const next = keys[event.key];
      if (next === undefined) return;
      event.preventDefault();
      activate(tabs[next], true);
    });
  });
</script>
